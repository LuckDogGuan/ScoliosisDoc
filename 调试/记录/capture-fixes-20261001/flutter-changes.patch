+      if (confirmed != true || controller.exitBlocked) return;
+      ticker?.cancel();
+      try {
+        await controller.shutdown().timeout(const Duration(seconds: 5));
+      } catch (error, stack) {
+        await ErrorLog.write('close', error, stack);
